def atRung (z k : Nat) : Rung :=
  let es := atomTables[z-1]!
  ⟨z,k,es[k]!.get!, es[k+1]!.get!⟩

def silver := atRung 47 0
def silicon := atRung 14 0
def nitrogen := atRung 7 5
def caesium := atRung 55 1

theorem historySourcesAlign :
    (olderValues.map List.length) = (olderWidths.map List.length) ∧
    atomTables.length = 60 ∧
    (atomTables.zipIdx).all (fun (es,i) => decide (es.length = i+2)) = true := by
  decide +kernel

theorem countLedgerAndCalls :
    central.length = 1819 ∧ complete.length = 1799 ∧
    ordinaryRungs.length = 1770 ∧ ordinaryComplete.length = 1751 ∧
    (central.filter Range.outside).length = 49 ∧
    (ordinaryRungs.filter (fun r => (point r).outside)).length = 8 := by
  decide +kernel

theorem missingBoxKeys :
    (allRungs.filter (fun r => (face? r).isNone)).map (fun r => (r.z,r.k)) =
    [(35,1), (35,2), (40,1), (40,2), (41,1), (41,2), (41,3), (43,0), (43,1), (43,2), (43,3), (44,2), (44,3), (45,1), (45,2), (45,3), (46,2), (46,3), (51,2), (51,3)] := by decide +kernel

theorem stableOnAllReportedBoxes : allRungs.all stable = true := by decide +kernel

theorem uniqueForwardContact :
    complete.all (fun row => decide (1 ≤ row.lo)) = true ∧
    allRungs.filterMap (fun r => do
      let row ← box r
      if row.lo ≤ 1 then some (r.z,r.k) else none) = [(60,10)] := by
  decide +kernel

theorem centralWindowAll (c : Rat) : Fits central c ↔
    (3788117/652235) ≤ c ∧ c < (20379200/3473803) := by
  have h := sharpRangeWindow central (point silver) (point silicon)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) c
  have l : (point silver).hi = (3788117/652235) := by decide +kernel
  have u : (point silicon).lo = (20379200/3473803) := by decide +kernel
  rw [l,u] at h
  exact h

theorem boxWindowAll (c : Rat) : Fits complete c ↔
    (7576259/1304450) ≤ c ∧ c < (6270500/1068863) := by
  have h := sharpRangeWindow complete ((box silver).get!) ((box silicon).get!)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) c
  have l : ((box silver).get!).hi = (7576259/1304450) := by decide +kernel
  have u : ((box silicon).get!).lo = (6270500/1068863) := by decide +kernel
  rw [l,u] at h
  exact h

theorem boxWindowOrdinary (c : Rat) : Fits ordinaryComplete c ↔
    (55206749/9788970) ≤ c ∧ c < (57893475000/9734764319) := by
  have h := sharpRangeWindow ordinaryComplete ((box nitrogen).get!) ((box caesium).get!)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) c
  have l : ((box nitrogen).get!).hi = (55206749/9788970) := by decide +kernel
  have u : ((box caesium).get!).lo = (57893475000/9734764319) := by decide +kernel
  rw [l,u] at h
  exact h

theorem alternativeCutoffs : Fits complete 5.82 ∧ Fits complete 5.83 ∧ Fits complete 5.85 ∧
    ¬ Fits complete 5.8 ∧ ¬ Fits complete 5.9 := by
  simp only [boxWindowAll]
  decide +kernel

