theorem allChargeBoxes :
    massBounds.length = 67 ∧
    (massBounds.take 57).all (fun p => decide (0 < p.1)) = true ∧
    (massBounds.drop 57).all (fun p => decide (p.2 < 0)) = true := by decide +kernel

theorem endpoints :
